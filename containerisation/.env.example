# ============================================================
# MetaRoboLearn – environment variable template
# Copy this file to .env  (same folder: containerisation/.env)
# and fill in all values before running docker compose.
# ============================================================

# ============================================================
# MetaRoboLearn - environment variable template
# Copy this file to .env  (same folder: containerisation/.env)
# and fill in all values before running docker compose.
# ============================================================

# --- Database ---
# Full SQLAlchemy connection string to your PostgreSQL instance.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>

# --- Flask ---
FLASK_SECRET_KEY=<long-random-secret-key>
FLASK_ENV=production

# --- CORS ---
# The URL the browser uses to reach the app.
# For local: https://localhost
# For production: https://yourdomain.com
CORS_ORIGIN=https://localhost

# --- Broker (optional external service) ---
BROKER_API_URL=http://<broker-host>:8000
BROKER_WS_URL=ws://<broker-host>:8000
BROKER_CLIENT_NAME=mrl-server
BROKER_API_KEY=<broker-api-key>
VIDEO_WS_URL=ws://<broker-host>:8001
BROKER_API_KEY=<broker-api-key>

VIDEO_WS_URL=ws://<video-host>:8001

