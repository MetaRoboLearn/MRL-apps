# ============================================================
# MetaRoboLearn – environment variable template
# Copy this file to .env  (same folder: containerisation/.env)
# and fill in all values before running docker compose.
# ============================================================

# ============================================================
# MetaRoboLearn - environment variable template
# Copy this file to .env  (same folder: containerisation/.env)
# and fill in all values before running docker compose.
# ============================================================

# --- Database ---
# Full SQLAlchemy connection string to your PostgreSQL instance.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>

# --- Flask ---
FLASK_SECRET_KEY=<long-random-secret-key>
FLASK_ENV=production

# --- CORS ---
# The URL the browser uses to reach the app.
# For local: https://localhost
# For production: https://yourdomain.com
CORS_ORIGIN=https://localhost

# --- Broker (optional external service) ---
BROKER_API_URL=http://<broker-host>:8000
BROKER_WS_URL=ws://<broker-host>:8000
BROKER_CLIENT_NAME=mrl-server
BROKER_API_KEY=<broker-api-key>
VIDEO_WS_URL=ws://<broker-host>:8001
BROKER_API_KEY=<broker-api-key>

VIDEO_WS_URL=ws://<video-host>:8001

# --- LLM feedback provider (server-side only) ---
# Select one mode for this backend deployment; this value is never sent to the browser.
LLM_FEEDBACK_PROVIDER=local #or remote

# Local LM Studio endpoint/model. For Docker development, host.docker.internal is
# available from the root compose file; set a reachable host address for production.
LLM_FEEDBACK_LOCAL_API_BASE=http://host.docker.internal:1234/v1
LLM_FEEDBACK_LOCAL_MODEL=google/gemma-4-26b-a4b-qat

# Remote Google AI Studio/Gemini settings. Supply the key as a protected deployment
# secret and choose a model enabled for the project; do not commit real credentials.
LLM_FEEDBACK_GEMINI_API_KEY=<google-ai-studio-api-key>
LLM_FEEDBACK_GEMINI_MODEL=<gemini-model-id>

